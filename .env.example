# Copy to .env (make setup does this). Never commit .env.
GOOGLE_CLOUD_PROJECT=gd-gcp-gridu-genai
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
LLM_MAX_CONCURRENCY=4

# Langfuse (EU cloud). Keys come from project-spec/creds.local (make env injects them). Tracing is off when empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostgreSQL (docker compose service). Inside the app container the host is `postgres`.
DATABASE_URL=postgresql://datagen:datagen@localhost:5432/datagen

DATA_DIR=data
DEFAULT_ROWS_PER_TABLE=100
MAX_ROWS_PER_TABLE=5000
SQL_ROW_LIMIT=500
SQL_TIMEOUT_MS=15000
